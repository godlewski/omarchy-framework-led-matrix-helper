#!/usr/bin/env python3
# PNG <-> 306-bit frame codec for the godlewski.framework-led-matrix-helper
# plugin. Frames are 9x34, row-major strings of 0/1.
#
#   led-matrix-png encode <bits> <out.png>   write our canonical grayscale PNG
#   led-matrix-png decode <in.png>           print bits (any 9x34 PNG: gray,
#                                            RGB, palette, alpha; bit depths
#                                            1/2/4/8; filters 0-4)
#   led-matrix-png decode-dir <dir>          print "name|bits" per *.png
#
# Decode is deliberately liberal so patterns drawn in any editor import: a
# pixel is ON when its luminance > 50% and it is not mostly transparent.
# Interlaced (Adam7) and 16-bit PNGs are rejected.

import errno
import os
import stat
import struct
import sys
import zlib

W, H = 9, 34

# A legitimate 9x34 PNG is under 2KB; anything near this cap is not a
# pattern. Enforced by read_bounded() on the open descriptor, so hostile
# files dropped into the pattern library or fed to import cost nothing.
MAX_FILE_BYTES = 256 * 1024


def read_bounded(path, limit):
    """Read a regular file of at most `limit` bytes.

    Opens exactly once — without following symlinks, non-blocking — checks
    the descriptor is a regular file, and reads at most limit+1 bytes from
    that same descriptor. A FIFO, device node, oversized file, or a path
    swapped between check and read therefore cannot block or exhaust memory.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                     | os.O_CLOEXEC | os.O_NOCTTY)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise ValueError("symlinks are not followed; use the real file")
        raise
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("not a regular file")
        data = bytearray()
        while len(data) <= limit:
            chunk = os.read(fd, min(65536, limit + 1 - len(data)))
            if not chunk:
                break
            data += chunk
    finally:
        os.close(fd)
    if len(data) > limit:
        raise ValueError(f"file too large (max {limit // 1024}KB)")
    return bytes(data)
MAX_CHUNKS = 1000


def chunk(typ, data):
    x = typ + data
    return struct.pack(">I", len(data)) + x + struct.pack(">I", zlib.crc32(x) & 0xFFFFFFFF)


def encode(bits, path):
    if len(bits) != W * H:
        raise ValueError(f"need {W * H} bits, got {len(bits)}")
    raw = b""
    for y in range(H):
        raw += b"\x00" + bytes(255 if bits[y * W + x] == "1" else 0 for x in range(W))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 0, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


def paeth(a, b, c):
    p = a + b - c
    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
    if pa <= pb and pa <= pc:
        return a
    return b if pb <= pc else c


def unfilter(raw, height, stride, bpp):
    out = bytearray()
    prev = bytearray(stride)
    pos = 0
    for _ in range(height):
        ft = raw[pos]
        line = bytearray(raw[pos + 1:pos + 1 + stride])
        pos += 1 + stride
        for i in range(stride):
            a = line[i - bpp] if i >= bpp else 0
            b = prev[i]
            c = prev[i - bpp] if i >= bpp else 0
            if ft == 1:
                line[i] = (line[i] + a) & 0xFF
            elif ft == 2:
                line[i] = (line[i] + b) & 0xFF
            elif ft == 3:
                line[i] = (line[i] + (a + b) // 2) & 0xFF
            elif ft == 4:
                line[i] = (line[i] + paeth(a, b, c)) & 0xFF
            elif ft != 0:
                raise ValueError(f"unknown filter {ft}")
        out += line
        prev = line
    return bytes(out)


def unpack_bits(line, depth, count):
    # Expand sub-byte samples to one value per pixel, scaled to 0-255 for
    # grayscale use; palette indices must NOT be scaled (handled by caller).
    vals = []
    per_byte = 8 // depth
    mask = (1 << depth) - 1
    for i in range(count):
        byte = line[i // per_byte]
        shift = 8 - depth * (i % per_byte + 1)
        vals.append((byte >> shift) & mask)
    return vals


def decode(path):
    data = read_bounded(path, MAX_FILE_BYTES)
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    pos, idat, plte, trns = 8, b"", b"", b""
    w = h = depth = ctype = interlace = None
    chunks = 0
    while pos + 8 <= len(data):
        chunks += 1
        if chunks > MAX_CHUNKS:
            raise ValueError("too many chunks")
        ln = struct.unpack(">I", data[pos:pos + 4])[0]
        if ln > len(data) - pos - 12:
            raise ValueError("truncated chunk")
        typ = data[pos + 4:pos + 8]
        body = data[pos + 8:pos + 8 + ln]
        if typ == b"IHDR":
            w, h, depth, ctype, _, _, interlace = struct.unpack(">IIBBBBB", body[:13])
        elif typ == b"PLTE":
            plte = body
        elif typ == b"tRNS":
            trns = body
        elif typ == b"IDAT":
            idat += body
        elif typ == b"IEND":
            break
        pos += 12 + ln
    if (w, h) != (W, H):
        raise ValueError(f"must be {W}x{H}, got {w}x{h}")
    if interlace:
        raise ValueError("interlaced PNG not supported")
    if depth == 16:
        raise ValueError("16-bit PNG not supported")

    channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(ctype)
    if channels is None:
        raise ValueError(f"unsupported color type {ctype}")
    if depth != 8 and ctype not in (0, 3):
        raise ValueError(f"bit depth {depth} only supported for gray/palette")

    stride = (w * channels * depth + 7) // 8
    bpp = max(1, channels * depth // 8)
    # Bounded decompression: a valid image inflates to exactly (stride+1)*h
    # bytes (~1.3KB here). Capping at expected+1 means a decompression bomb
    # overshoots by one byte and is rejected, without ever inflating further.
    expected = (stride + 1) * h
    raw = zlib.decompressobj().decompress(idat, expected + 1)
    if len(raw) != expected:
        raise ValueError("IDAT size mismatch")
    raw = unfilter(raw, h, stride, bpp)

    scale = 255 // ((1 << depth) - 1) if depth < 8 else 1
    bits = ""
    for y in range(H):
        line = raw[y * stride:(y + 1) * stride]
        if depth < 8:
            samples = unpack_bits(line, depth, w)
        else:
            samples = list(line)
        for x in range(W):
            if ctype == 3:  # palette
                idx = samples[x]
                r, g, b = plte[idx * 3:idx * 3 + 3]
                alpha = trns[idx] if idx < len(trns) else 255
            else:
                px = samples[x * channels:(x + 1) * channels]
                if ctype == 0:
                    r = g = b = px[0] * scale
                    alpha = 255
                elif ctype == 4:
                    r = g = b = px[0]
                    alpha = px[1]
                elif ctype == 2:
                    r, g, b = px
                    alpha = 255
                else:  # 6
                    r, g, b, alpha = px
            lum = 0.299 * r + 0.587 * g + 0.114 * b
            bits += "1" if lum > 127 and alpha > 127 else "0"
    return bits


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "encode":
        encode(sys.argv[2], sys.argv[3])
    elif mode == "decode":
        print(decode(sys.argv[2]))
    elif mode == "decode-dir":
        d = sys.argv[2]
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".png"):
                continue
            try:
                print(fn[:-4] + "|" + decode(os.path.join(d, fn)))
            except Exception as e:
                print(f"skipping {fn}: {e}", file=sys.stderr)
    else:
        print(__doc__ or "usage: led-matrix-png encode|decode|decode-dir", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"led-matrix-png: {e}", file=sys.stderr)
        sys.exit(1)
